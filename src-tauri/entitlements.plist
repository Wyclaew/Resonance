<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ⚠️ NOTARIZE EDİLEN UYGULAMA "hardened runtime" ile imzalanır ve orada
       varsayılan olarak PEK ÇOK ŞEY YASAKTIR. Resonance bundle'ının İÇİNDEN
       iki yabancı ikili çalıştırıyor (yt-dlp, ffmpeg); yt-dlp bir Python
       paketi olduğu için kendi kütüphanelerini çalışma anında yüklüyor.
       Bu izinler olmadan notarize edilmiş sürüm açılır ama İNDİRME ÇALIŞMAZ
       ("Library not loaded" / süreç anında ölür). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Ağ: YouTube/Supabase/lrclib istekleri. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
